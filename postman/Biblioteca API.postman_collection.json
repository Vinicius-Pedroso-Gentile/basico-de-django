              ],
              "path": [
                "livros",
                "{{livro_id}}",
                ""
              ]
            }
          }
        },
        {
          "name": "Atualizar livro (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"preco\": \"19.90\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/livros/{{livro_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "livros",
                "{{livro_id}}",
                ""
              ]
            }
          }
        },
        {
