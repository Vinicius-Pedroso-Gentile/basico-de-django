              "raw": "{\n  \"titulo\": \"Livro do Futuro\",\n  \"isbn\": \"abc\",\n  \"ano_publicacao\": 3000,\n  \"paginas\": 100,\n  \"preco\": \"10.00\",\n  \"autor_id\": 1\n}",
              "options": {
